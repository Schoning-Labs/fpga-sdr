# Force LF for the generated register-map output (docs/REGMAP.md): tools/check.sh
# regenerates these with `cargo run -p xtask -- regmap`, which always writes `\n` regardless of
# OS, then fails the build if the regenerated bytes differ from what is committed. Without this,
# a Windows checkout (core.autocrlf=true) materializes these files with CRLF, which would fail
# that byte comparison on every clean checkout even when nothing is actually stale. Scoped to
# just the generated paths and the TOML that feeds them, not the whole repository, so this
# doesn't retroactively renormalize files another in-flight branch owns.
hw/regmap/generated/*.vh text eol=lf
hw/regmap/*.toml text eol=lf
fw/tr-regs/src/generated.rs text eol=lf
