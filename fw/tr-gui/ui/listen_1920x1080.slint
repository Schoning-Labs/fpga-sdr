//
// LISTEN screen as a window of its own, for the host test. The firmware shows
// `AppScreen1920x1080` (app_1920x1080.slint), which holds this view as well.

import { ListenView } from "listen_view.slint";
export { ListenModel, ListenTick } from "listen_model.slint";

export component ListenScreen1920x1080 inherits Window {
    width: 1920px;
    height: 1080px;
    ListenView { }
}
