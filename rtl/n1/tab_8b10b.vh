// x in bits [4:0], y in bits [7:5] of byte_in, same packing as an 8B value.
function automatic [10:0] enc8b10b_k(input [7:0] byte_in, input rd_in);
    reg [10:0] t;
    begin
        case ({rd_in, byte_in})
            9'b0_11110111: t = {10'b1110101000, 1'b0};
            9'b1_11110111: t = {10'b0001010111, 1'b1};
            9'b0_11111011: t = {10'b1101101000, 1'b0};
            9'b1_11111011: t = {10'b0010010111, 1'b1};
            9'b0_00011100: t = {10'b0011110100, 1'b0};
            9'b1_00011100: t = {10'b1100001011, 1'b1};
            9'b0_00111100: t = {10'b0011111001, 1'b1};
            9'b1_00111100: t = {10'b1100000110, 1'b0};
            9'b0_01011100: t = {10'b0011110101, 1'b1};
            9'b1_01011100: t = {10'b1100001010, 1'b0};
            9'b0_01111100: t = {10'b0011110011, 1'b1};
            9'b1_01111100: t = {10'b1100001100, 1'b0};
            9'b0_10011100: t = {10'b0011110010, 1'b0};
            9'b1_10011100: t = {10'b1100001101, 1'b1};
            9'b0_10111100: t = {10'b0011111010, 1'b1};
            9'b1_10111100: t = {10'b1100000101, 1'b0};
            9'b0_11011100: t = {10'b0011110110, 1'b1};
            9'b1_11011100: t = {10'b1100001001, 1'b0};
            9'b0_11111100: t = {10'b0011111000, 1'b0};
            9'b1_11111100: t = {10'b1100000111, 1'b1};
            9'b0_11111101: t = {10'b1011101000, 1'b0};
            9'b1_11111101: t = {10'b0100010111, 1'b1};
            9'b0_11111110: t = {10'b0111101000, 1'b0};
            9'b1_11111110: t = {10'b1000010111, 1'b1};
            default: t = 11'bx; // not a legal K code -- caller must not request it
        endcase
        enc8b10b_k = t;
    end
endfunction

