//
// Pin constraint fragment for the Sipeed Tang Mega 138K Pro dock's RJ45 port (RTL8211FI-CG
// PHY, U10) -- the RGMII bus, MDIO, and the PHY's clock/reset pins. See docs/H3_PHY.md for the
// full derivation and citations; in short, every pin location below is read directly from the
// dock schematic's own RGMII_ETHNET sheet (Sipeed, "TANG_MEGA-138K_Pro-Dock-4071f_Schematics.pdf",
// sheet RGMII_sch.kicad_sch), not inferred or copied from a different board.
//
// This is a fragment, not a whole-chip constraints file: the chip top level (gowin/p1/sdr.cst) is what
// concatenates this with every other block's own pin/clock constraints and adds the SDC-side
// timing constraints (create_clock on the 50 MHz input, the RGMII receive clock, and any
// input/output delay needed once real board timing is being closed -- not part of this file).
//
// I/O standard: LVCMOS33 throughout. The dock straps the PHY's RGMII I/O rail to external 3.3 V
// (CFG_EXT pulled up to PHY_VIO, docs/H3_PHY.md section 1), so this is the rail these pins
// actually run at, not merely this chip's own default.
//
// Port names below match rtl/hl2link/hl2_link_tx_top.v's `rgmii_txd`/`rgmii_tx_ctl`,
// rtl/hl2link/hl2_link_rx_top.v's `rgmii_rxd`/`rgmii_rx_ctl`, and rtl/hl2link/phy_setup_top.v
// so whoever wires the chip top level's own port names differently only needs to update
// the left-hand identifiers here, not re-derive any pin number.

// ---- RGMII transmit (FPGA -> PHY): output pins ----
IO_LOC "rgmii_txd[0]" K21;
IO_LOC "rgmii_txd[1]" J21;
IO_LOC "rgmii_txd[2]" L19;
IO_LOC "rgmii_txd[3]" K18;
IO_LOC "rgmii_tx_ctl" J24;   // RGMII_TXEN
IO_LOC "rgmii_txc"    H24;   // RGMII_TXCK -- eth_clk_pll.v `clk_125` (GTX_CLK)

IO_PORT "rgmii_txd[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "rgmii_txd[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "rgmii_txd[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "rgmii_txd[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "rgmii_tx_ctl" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "rgmii_txc"    IO_TYPE=LVCMOS33 DRIVE=8;

// ---- RGMII receive (PHY -> FPGA): input pins ----
// (Read from the same RGMII_sch sheet as the TX pins above.)
IO_LOC "rgmii_rxd[0]"  B26;
IO_LOC "rgmii_rxd[1]"  C26;
IO_LOC "rgmii_rxd[2]"  D26;
IO_LOC "rgmii_rxd[3]"  E26;
IO_LOC "rgmii_rx_ctl"  C22;   // RGMII_RXDV
IO_LOC "rgmii_rxc"     C23;   // RGMII_RXCK -- source-synchronous, forwarded by the PHY (the receive clock, clk_rx)

IO_PORT "rgmii_rxd[0]" IO_TYPE=LVCMOS33;
IO_PORT "rgmii_rxd[1]" IO_TYPE=LVCMOS33;
IO_PORT "rgmii_rxd[2]" IO_TYPE=LVCMOS33;
IO_PORT "rgmii_rxd[3]" IO_TYPE=LVCMOS33;
IO_PORT "rgmii_rx_ctl" IO_TYPE=LVCMOS33;
IO_PORT "rgmii_rxc"    IO_TYPE=LVCMOS33;

// ---- MDIO (shared with the PHY's management interface) ----
IO_LOC "phy_mdio" K22;   // RGMII_MDIO -- bidirectional; top level tristates through phy_mdio_oe
IO_LOC "phy_mdc"  K23;   // RGMII_MDC

IO_PORT "phy_mdio" IO_TYPE=LVCMOS33 PULL_MODE=UP;   // board already has R70 (1.5k to PHY_VIO);
                                                     // this is a defensive weak pull only
IO_PORT "phy_mdc"  IO_TYPE=LVCMOS33 DRIVE=8;

// ---- PHY clock and reset ----
IO_LOC "phy_clk"   E18;   // EPHY_CLK -- eth_clk_pll.v `clk_25` (25 MHz PHY reference)
IO_LOC "phy_rst_n" E17;   // EPHY_~{RST} -- active low, phy_reset_seq.v

IO_PORT "phy_clk"   IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "phy_rst_n" IO_TYPE=LVCMOS33 DRIVE=8;
